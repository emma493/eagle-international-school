# Firebase configuration (get from Firebase Console -> Project settings)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# API base (points to Cloudflare Worker dev server in development)
VITE_API_BASE=http://localhost:8787/api

# Firebase Cloud Messaging (FCM) VAPID key for push notification subscription
VITE_FCM_VAPID_KEY=your_vapid_key
