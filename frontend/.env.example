# Firebase configuration (get from Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=

# API base (points to Cloudflare Worker dev server in development)
VITE_API_BASE=http://localhost:8787

# Firebase Cloud Messaging (FCM) VAPID key for push notification subscription
VITE_FCM_VAPID_KEY=your_vapid_key_here

# Realtime Database URL (live pulse signals)
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
